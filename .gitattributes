# Auto-detect text files
* text=auto

# Shell scripts must use LF
*.sh text eol=lf
*.yml text eol=lf

# Binary files
*.jar binary
*.so binary
*.png binary
# Windows batch files must keep CRLF — cmd.exe mangles LF-only batches
# (commands lose their first characters and fail).
*.cmd text eol=crlf
*.bat text eol=crlf
